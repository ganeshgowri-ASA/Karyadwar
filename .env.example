# Database - PostgreSQL connection string (Railway, Supabase, or local)
DATABASE_URL="postgresql://username:password@localhost:5432/karyadwar?schema=public"

# NextAuth - Required for authentication
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-this-in-production"

# Optional: Direct URL for Prisma migrations (needed for connection pooling like PgBouncer)
# DIRECT_URL="postgresql://username:password@localhost:5432/karyadwar?schema=public"
